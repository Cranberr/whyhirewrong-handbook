---
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';

const { handbook } = Astro.props;
const { Content, headings } = await render(handbook);

const chapters = (await getCollection('handbook')).sort((a, b) => a.data.order - b.data.order);
const i = chapters.findIndex((c) => c.id === handbook.id);
const previous = chapters[i - 1];
const next = chapters[i + 1];
const toc = headings.filter((h) => h.depth === 2);
---

<Base
  title={`${handbook.data.title} | WhyHireWrong? Handbook`}
  description={handbook.data.description}
  url={`https://whyhirewrong.com/handbook/${handbook.id}/`}
  editPath={`src/content/handbook/${handbook.id}.mdx`}
>
  <div class="grid">
    <aside class="side">
      <nav aria-label="Handbook chapters">
        {chapters.map((c) => (
          <a href={`/handbook/${c.id}/`} class:list={['nav-a', { on: c.id === handbook.id }]} aria-current={c.id === handbook.id ? 'page' : undefined}>
            <span class="nav-n">{String(c.data.order).padStart(2, '0')}</span>{c.data.title}
          </a>
        ))}
      </nav>
    </aside>

    <main id="content">
      <article class="prose" data-pagefind-body>
        <p class="kicker">chapter {String(handbook.data.order).padStart(2, '0')}</p>
        <h1>{handbook.data.title}</h1>
        <p class="lede">{handbook.data.description}</p>
        <Content />
      </article>

      <div class="pn">
        {previous ? <a href={`/handbook/${previous.id}/`}>← {previous.data.title}</a> : <span />}
        {next ? <a href={`/handbook/${next.id}/`}>{next.data.title} →</a> : <span />}
      </div>
      <p class="meta">Last updated {handbook.data.updated.toLocaleDateString('en-GB')} · Owner: {handbook.data.owner}</p>
    </main>

    {toc.length > 1 && (
      <aside class="toc">
        <p class="toc-h">On this page</p>
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </aside>
    )}
  </div>
</Base>
