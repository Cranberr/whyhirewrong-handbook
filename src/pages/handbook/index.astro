---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const chapters = (await getCollection('handbook')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="WhyHireWrong? Handbook: the complete protocol"
  description="How WhyHireWrong? works: how I run searches, screen and verify candidates, build shortlists, charge, use AI, and represent job seekers through Career Re:Work."
  url="https://whyhirewrong.com/handbook/"
>
  <main id="content" class="home">
    <p class="kicker">the whyhirewrong? handbook</p>
    <h1>Hire proof, <span class="gt">not promises.</span></h1>
    <p class="lede">
      This is the complete WhyHireWrong? protocol, written by me, Hubert Warszta. It covers how I run a search,
      how I screen and verify people, what goes into a shortlist, what's included, how I charge, how I use AI,
      and how Career Re:Work represents job seekers. It's the same thing I tell clients and candidates, written down.
    </p>
    <ol class="toc-list">
      {chapters.map((c) => (
        <li>
          <a href={`/handbook/${c.id}/`}>
            <span class="nav-n">{String(c.data.order).padStart(2, '0')}</span>
            <span class="t">{c.data.title}</span>
            <span class="d">{c.data.description}</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>
